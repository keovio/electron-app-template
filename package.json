{
  "name": "electron-app-template",
  "version": "0.3.3",
  "description": "跨平台 Electron 应用模板：内置增量更新（应用层热更新 + 坏版本自动回滚）",
  "main": "boot/bootstrap.js",
  "private": true,
  "license": "MIT",
  "author": "keovio",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test \"test/*.test.js\"",
    "pack": "electron-builder --config electron-builder.config.js --dir --publish never",
    "dist": "electron-builder --config electron-builder.config.js --publish never",
    "smoke": "node scripts/smoke.js",
    "build:layer": "node build/build-layer.js"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "^44.10.0",
    "electron-builder": "^26.0.12"
  }
}
